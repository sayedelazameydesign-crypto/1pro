{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{docs/**,scripts/**,tests/**,.github/**,skills/**,_handoff/**,render.yaml}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
